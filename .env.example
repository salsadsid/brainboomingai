# ─── Required ────────────────────────────────────────────────
GOOGLE_API_KEY=              # Google Gemini API key (https://aistudio.google.com/apikey)
MONGODB_URI=                 # MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/dbname)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Auth.js ─────────────────────────────────────────────────
AUTH_SECRET=                 # Generate with: openssl rand -base64 33
AUTH_URL=http://localhost:3000

# ─── Google OAuth 2.0 ────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Magic-link email (SMTP via Nodemailer) ──────────────────
# Default is Gmail. Create a 16-char App Password (needs 2-Step Verification):
#   Google Account → Security → 2-Step Verification → App passwords
# EMAIL_FROM should match EMAIL_SERVER_USER.
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# ─── Sentry (optional) ───────────────────────────────────────
# Get DSN at: https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=           # For source map uploads
SENTRY_ORG=
SENTRY_PROJECT=
