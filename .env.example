# ─── Required ────────────────────────────────────────────────
GOOGLE_API_KEY=              # Google Gemini API key (https://aistudio.google.com/apikey)
MONGODB_URI=                 # MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/dbname)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── SEO ─────────────────────────────────────────────────────
# Canonical origin for canonical tags, sitemap.xml, robots.txt and JSON-LD.
# Defaults to https://brainboomingai.vercel.app. Set this to the custom domain
# when one is added — every SEO URL derives from it, so nothing else changes.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search Console verification token (the content="..." of the meta tag Google
# gives you). Optional — leave blank until you verify the property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Auth.js ─────────────────────────────────────────────────
AUTH_SECRET=                 # Generate with: openssl rand -base64 33
AUTH_URL=http://localhost:3000

# ─── Google OAuth 2.0 ────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Magic-link email (Brevo HTTP API) ───────────────────────
# Free: 300/day, no domain, no card — https://www.brevo.com
#   1. Verify a sender: Senders, Domains & IPs → Senders
#   2. API KEY (starts "xkeysib-"): Settings → SMTP & API → "API Keys" tab.
#      NOT the SMTP key ("xsmtpsib-") — the HTTP API rejects that with "Key not found".
# EMAIL_FROM must be a Brevo-verified sender address.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Brain Booming

# ─── Sentry (optional) ───────────────────────────────────────
# Get DSN at: https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=           # For source map uploads
SENTRY_ORG=
SENTRY_PROJECT=
